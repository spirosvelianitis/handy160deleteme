{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Public handyman business profile, bio, credentials, and base pricing rates.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "craftsmanName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "headline": { "type": "string", "minLength": 5, "maxLength": 140 },
        "serviceArea": { "type": "string", "minLength": 2, "maxLength": 120 },
        "yearsExperience": { "type": "integer" },
        "completedJobs": { "type": "integer" },
        "hourlyRate": { "type": "number" },
        "minimumCallout": { "type": "number" },
        "bioSummary": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "phoneDisplay": { "type": "string", "minLength": 7, "maxLength": 30 },
        "emailDisplay": { "type": "string", "minLength": 5, "maxLength": 120 },
        "licenseInfo": { "type": "string", "minLength": 3, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "businessName",
        "craftsmanName",
        "headline",
        "serviceArea",
        "yearsExperience",
        "completedJobs",
        "hourlyRate",
        "minimumCallout",
        "bioSummary",
        "phoneDisplay",
        "emailDisplay",
        "licenseInfo",
        "updatedAt"
      ]
    },
    "Project": {
      "title": "Project",
      "description": "Completed handyman craftsmanship showcase item for the public photo gallery.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": {
          "type": "string",
          "enum": ["Carpentry", "Kitchen & Bath", "Exterior", "Electrical & Lighting"]
        },
        "neighborhood": { "type": "string", "minLength": 2, "maxLength": 80 },
        "duration": { "type": "string", "minLength": 2, "maxLength": 40 },
        "materials": { "type": "string", "minLength": 2, "maxLength": 140 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 600 },
        "imageUrl": { "type": "string", "minLength": 5, "maxLength": 500 },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "category",
        "neighborhood",
        "duration",
        "materials",
        "summary",
        "imageUrl",
        "featured",
        "sortOrder",
        "createdAt"
      ]
    },
    "ScheduleSlot": {
      "title": "ScheduleSlot",
      "description": "Public non-PII slot availability lock indicating booked or shop-blocked appointment windows.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "slotKey": {
          "type": "string",
          "enum": ["morning", "midday", "afternoon"]
        },
        "status": {
          "type": "string",
          "enum": ["booked", "blocked"]
        },
        "appointmentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "note": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "slotKey", "status", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Customer appointment booking containing PII restricted to the booking owner or admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "clientEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "clientPhone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "serviceAddress": { "type": "string", "minLength": 5, "maxLength": 200 },
        "serviceCategory": {
          "type": "string",
          "enum": [
            "Carpentry & Trim",
            "Kitchen & Bath",
            "Drywall & Paint",
            "Doors & Hardware",
            "Decks & Exterior",
            "Electrical & Fixtures",
            "General Maintenance"
          ]
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "slotKey": {
          "type": "string",
          "enum": ["morning", "midday", "afternoon"]
        },
        "slotId": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_(morning|midday|afternoon)$"
        },
        "description": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"]
        },
        "adminNotes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "clientName",
        "clientEmail",
        "clientPhone",
        "serviceAddress",
        "serviceCategory",
        "date",
        "slotKey",
        "slotId",
        "description",
        "status",
        "adminNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Estimate": {
      "title": "Estimate",
      "description": "Customer cost estimate request and contractor quote response.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "clientEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "clientPhone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "neighborhood": { "type": "string", "minLength": 2, "maxLength": 100 },
        "jobType": { "type": "string", "minLength": 2, "maxLength": 80 },
        "scopeUnits": { "type": "integer" },
        "complexity": { "type": "string", "enum": ["standard", "moderate", "complex"] },
        "materialsBy": { "type": "string", "enum": ["client", "handyman"] },
        "urgency": { "type": "string", "enum": ["flexible", "priority"] },
        "estimatedMin": { "type": "number" },
        "estimatedMax": { "type": "number" },
        "estimatedHours": { "type": "string", "maxLength": 30 },
        "projectNotes": { "type": "string", "minLength": 5, "maxLength": 1200 },
        "status": { "type": "string", "enum": ["requested", "quoted", "accepted", "archived"] },
        "formalQuoteAmount": { "type": "number" },
        "adminNotes": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "clientName",
        "clientEmail",
        "clientPhone",
        "neighborhood",
        "jobType",
        "scopeUnits",
        "complexity",
        "materialsBy",
        "urgency",
        "estimatedMin",
        "estimatedMax",
        "estimatedHours",
        "projectNotes",
        "status",
        "formalQuoteAmount",
        "adminNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized handyman administrator UID record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/profile/{profileId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Public handyman profile and service rate metadata."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Public portfolio craftsmanship showcase gallery."
    },
    "/schedule_slots/{slotId}": {
      "schema": { "$ref": "#/entities/ScheduleSlot" },
      "description": "Non-PII public schedule slot availability (booked or blocked)."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private customer appointment records with PII."
    },
    "/estimates/{estimateId}": {
      "schema": { "$ref": "#/entities/Estimate" },
      "description": "Private customer estimate requests and formal contractor quotes."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Handyman administrator role lookup."
    }
  }
}
